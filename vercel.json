{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "server/supabase-ca.crt"
    }
  }
}
