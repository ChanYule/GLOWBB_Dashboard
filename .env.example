# Server-only. Copy the Transaction pooler URI from Supabase > Connect.
# Replace the placeholder with a URL-encoded database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
APP_ORIGIN=https://glowbbdashboard.vercel.app
# Supabase's public CA is bundled automatically; no certificate setting is needed.
# Optional override/additional CA for a custom PostgreSQL provider:
# DATABASE_CA_CERT=

# Staff sign-in. The dashboard now opens directly using the shared workspace.
DASHBOARD_AUTH=0
# SQLite only: keep this directory and DB_PATH on the same persistent backed-up volume.
# CENTRE_DATA_DIR=C:/persistent/dashboard/centres

# Optional OneMap service credentials. Server-only: never use VITE_ names.
# Prefer email/password for automatic server-side renewal, or provide a token.
# ONEMAP_EMAIL=
# ONEMAP_PASSWORD=
# ONEMAP_TOKEN=
